#!/bin/bash
#PBS -N QC_report
#PBS -P vz35
#PBS -l wd
#PBS -m e
#PBS -M ziyan.zhang@anu.edu.au
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:15:00
#PBS -l storage=gdata/vz35
#PBS -q normal

#--------README---------------------------------------------------------------
# Per-sample QC report (PASS / CHECK / FAIL) for a finished pipeline run.
# Wraps qc_report.py; writes everything to <output_dir>/qc_report/.
#
# run_script.qsub already runs qc_report.py at the end of every job, so this
# wrapper is only for re-running it: after changing qc_config.yaml, on a past
# run, or if the in-job report failed. It reads small tables only
# (demux_qc/ + read_counts_summary.txt) -- no FASTQ, Minibar or Chopper --
# and takes seconds:
#
#   qsub -v output_dir=<run output dir> run_qc_report.qsub
#
# Or chain it after a pipeline job run with run_qc_report=0:
#
#   jid=$(qsub run_script.qsub)
#   qsub -W depend=afterok:$jid -v output_dir=<run output dir> run_qc_report.qsub
#
# output_dir: run_script.qsub builds it from the date its job *starts*, so
# pass the real dir with -v output_dir=... rather than relying on today's
# date here; the job stops with an error if the dir does not exist.
#
# Python packages: needs PyYAML, and matplotlib for the plots (the tables are
# still written without it). If the preflight below fails, once per user:
#
#   module load python3/3.12.1 && pip install --user pyyaml matplotlib
#-----------------------------------------------------------------------------

set -euo pipefail

#--------Module---------------------------------------------------------------
module load python3/3.12.1

date_stamp=$(date +%Y%m%d)

#--------Variables (edit per run, or override with qsub -v)-------------------
# Same values as the run_script.qsub that produced the run.
samplesheet=${samplesheet:-/g/data/vz35/ONT_16s_workflow/sample_sheet/16s_samplesheet.csv}
output_dir=${output_dir:-/g/data/vz35/ONT_16s_workflow/minibar_output/ONT_16S_TBC_${date_stamp}}

#--------DONT-CHANGE----------------------------------------------------------
tools_dir=/g/data/vz35/ONT_16s_workflow/tools/brf_ont_16s_workflow/
qc_script=${tools_dir}/qc_report.py
qc_config=${qc_config:-${tools_dir}/qc_config.yaml}

if [[ ! -d "$output_dir" ]]; then
    echo "ERROR: output_dir not found: ${output_dir}" >&2
    echo "       pass the pipeline's run dir with  qsub -v output_dir=..." >&2
    exit 1
fi

if ! python3 -c "import yaml" 2>/dev/null; then
    echo "ERROR: PyYAML not available. Once per user:" >&2
    echo "       module load python3/3.12.1 && pip install --user pyyaml matplotlib" >&2
    exit 1
fi
if ! python3 -c "import matplotlib" 2>/dev/null; then
    echo "WARNING: matplotlib not available; tables only, no heatmaps." >&2
fi

echo "========================================"
echo " QC report: $(date)"
echo " Output dir:  ${output_dir}"
echo " Samplesheet: ${samplesheet}"
echo " Config:      ${qc_config}"
echo "========================================"

python3 "$qc_script" \
    --output-dir  "$output_dir" \
    --samplesheet "$samplesheet" \
    --config      "$qc_config"
